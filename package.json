{
  "name": "agent-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Gerenciador local de agentes de IA em terminais reais no Windows.",
  "author": "CodeHolistic",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "postinstall": "node scripts/patch-node-pty.mjs",
    "predev": "node scripts/patch-node-pty.mjs && electron-rebuild -f -w node-pty",
    "dev": "electron-vite dev",
    "prebuild": "node scripts/patch-node-pty.mjs && electron-rebuild -f -w node-pty",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "node scripts/ensure-node-pty.mjs && vitest run",
    "dist": "npm run build && electron-builder --win",
    "rebuild:electron": "node scripts/patch-node-pty.mjs && electron-rebuild -f -w node-pty",
    "rebuild:node": "node scripts/patch-node-pty.mjs && npm rebuild node-pty"
  },
  "dependencies": {
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.12.0",
    "tailwind-merge": "^3.0.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@tailwindcss/vite": "^4.0.9",
    "@types/node": "^22.13.8",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "electron-rebuild": "^3.2.9",
    "electron-vite": "^3.0.0",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  }
}
